# Copy to .env and fill in. .env is gitignored; never commit it.

# Required. Reusable + ephemeral + pre-approved key from
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Tailscale machine name and /etc/hostname. Default: ServerStick
TS_HOSTNAME=ServerStick

# Optional root password for the local console (tty1, serial). Only its SHA-512 hash goes into the ISO.
# Empty: root has no password and anyone at the keyboard gets a root shell. Tailscale SSH never asks for it.
ROOT_PASSWORD=

# Optional, space-separated extra Arch packages (each one also has to fit in RAM).
EXTRA_PACKAGES=""

# Optional. Maximum RAM for runtime writes (installed packages, files, logs):
# a percentage of RAM (1%-100%) or a fixed size like 8G / 512M. It is a limit, not a reservation.
# The system image itself (~1.5 GB without extras) is loaded into RAM in addition to this.
COW_SPACESIZE=50%

# Optional Wi-Fi (WPA-PSK). Set both or neither.
WIFI_SSID=
WIFI_PASSWORD=

# Optional fixed wired address, for networks without DHCP. Empty: DHCP (default).
# STATIC_IP is a.b.c.d/nn (/24 if no prefix). STATIC_GATEWAY may stay empty: the boot fallback then
# finds a working one. STATIC_DNS: space-separated; default is the gateway, 1.1.1.1, 9.9.9.9.
# With NET_FALLBACK=1, a static config that can't reach the internet is dropped for that boot:
# DHCP is tried next, then the gateway scan (serverstick-gwscan.lua) using STATIC_IP as the address.
STATIC_IP=
STATIC_GATEWAY=
STATIC_DNS=

# Optional. 1 (default): if there is no working IPv4 (static, or DHCP within NET_FALLBACK_WAIT),
# netfind-fallback.service tests every possible gateway heard on the wire and applies one that
# reaches the internet. It keeps watching: if the box loses its network (cable moved), it starts
# over. 0 disables it (and the static -> DHCP fallback).
NET_FALLBACK=1

# Optional. Seconds to wait for DHCP before scanning (5-3600). Default 45.
NET_FALLBACK_WAIT=45
