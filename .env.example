# Copy to .env and fill in. .env is gitignored; never commit it.

# Required. Reusable + ephemeral + pre-approved key from
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Tailscale machine name and /etc/hostname. Default: stickserver
TS_HOSTNAME=ServerStick

# Optional root password for the local console (tty1, serial). Only its SHA-512 hash goes into the ISO.
# Empty: root has no password and anyone at the keyboard gets a root shell. Tailscale SSH never asks for it.
ROOT_PASSWORD=

# Optional, space-separated extra Arch packages (each one also has to fit in RAM).
EXTRA_PACKAGES=""

# Optional. Maximum RAM for runtime writes (installed packages, files, logs):
# a percentage of RAM (1%-100%) or a fixed size like 8G / 512M. It is a limit, not a reservation.
# The system image itself (~1.5 GB without extras) is loaded into RAM in addition to this.
COW_SPACESIZE=50%

# Optional Wi-Fi (WPA-PSK). Set both or neither.
WIFI_SSID=
WIFI_PASSWORD=

# Optional. 1 (default): if DHCP gives no IPv4 within 2 minutes, netfind-fallback.service finds the
# gateway on the wire and sets a static address with NetworkManager. 0 disables it.
NET_FALLBACK=1
